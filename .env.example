# =============================================================================
# KodaLabs CMS - Environment Configuration
# =============================================================================
# For local development, copy this file to .env and update values
# For production deployment, all secrets are managed via GitHub Secrets

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3001
NODE_ENV=development

# PAYLOAD_SECRET - REQUIRED (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production: Set as GitHub Secret PAYLOAD_SECRET
PAYLOAD_SECRET=your-secret-here-min-32-chars

# PAYLOAD_PUBLIC_SERVER_URL - Public URL for Payload CMS
# Local development: http://localhost:3001
# Production VPS: https://cms.kodalabs.dev
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# PAYLOAD_CONFIG_PATH - Config file location
# Development: src/payload.config.ts
# Production: dist/payload.config.js (compiled)
PAYLOAD_CONFIG_PATH=src/payload.config.ts

# CI/CD Settings (for production deployment)
CI=true
PAYLOAD_DROP_DATABASE=false

# =============================================================================
# Database Configuration (PostgreSQL 16)
# =============================================================================
# Local development database
POSTGRES_DB=kodalabs_cms
POSTGRES_USER=kodalabs_cms
# Generate password: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Production: Set as GitHub Secret POSTGRES_PASSWORD
POSTGRES_PASSWORD=your-db-password

# DATABASE_URL - Connection string
# Local development: postgresql://kodalabs_cms:your-db-password@localhost:5432/kodalabs_cms
# Docker development: postgresql://kodalabs_cms:your-db-password@cms-postgres-dev:5432/kodalabs_cms
# Production VPS: postgresql://kodalabs_cms:PASSWORD@cms-postgres:5432/kodalabs_cms
DATABASE_URL=postgresql://kodalabs_cms:your-db-password@localhost:5432/kodalabs_cms

# =============================================================================
# CORS Origins - Allowed frontend domains
# =============================================================================
# Production: Set as GitHub Secrets
CORS_ORIGIN_PJ_CLT=https://pjouclt.com.br
CORS_ORIGIN_PJ_VS_CLT=https://pjvsclt.com.br
CORS_ORIGIN_KODALABS=https://kodalabs.dev

# =============================================================================
# Email Configuration (Optional - for notifications)
# =============================================================================
# Production: Set as GitHub Secrets EMAIL_HOST, EMAIL_USER, EMAIL_PASS
EMAIL_HOST=smtp.zoho.com
EMAIL_USER=info@kodalabs.dev
EMAIL_PASS=your-email-password

# =============================================================================
# AI Content Generation (Optional)
# =============================================================================
# Anthropic Claude API for AI-powered content generation
# Production: Set as GitHub Secret ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Custom AI content generation API
# Production: Set as GitHub Secret AI_CONTENT_API_KEY
AI_CONTENT_API_KEY=pk_ai-generator-xxx

# =============================================================================
# Webhooks (Optional - for triggering frontend deployments)
# =============================================================================
# Vercel deployment webhooks
# Production: Set as GitHub Secrets WEBHOOK_PJ_CLT, WEBHOOK_KODALABS
WEBHOOK_PJ_CLT=https://api.vercel.com/v1/integrations/deploy/xxx
WEBHOOK_KODALABS=https://api.vercel.com/v1/integrations/deploy/xxx

# =============================================================================
# Monitoring & Error Tracking (Optional)
# =============================================================================
# Sentry DSN for error tracking
# Production: Set as GitHub Secret SENTRY_DSN
SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# GitHub Container Registry (for production deployment only)
# =============================================================================
# These are automatically set by GitHub Actions during deployment
# GITHUB_USER - Repository owner (for Watchtower)
# GITHUB_TOKEN - Container registry token (GHCR_TOKEN secret)

# =============================================================================
# Production Deployment Notes
# =============================================================================
# The following GitHub Secrets must be configured in repository settings:
#
# REQUIRED SECRETS:
# - VPS_HOST: VPS IP address
# - VPS_USER: SSH username (max)
# - VPS_KEY: SSH private key
# - VPS_PASSPHRASE: SSH key passphrase
# - GHCR_TOKEN: GitHub Container Registry token
# - PAYLOAD_SECRET: Payload CMS secret (min 32 chars)
# - POSTGRES_PASSWORD: Database password
# - CORS_ORIGIN_PJ_CLT: https://pjouclt.com.br
# - CORS_ORIGIN_KODALABS: https://kodalabs.dev
#
# OPTIONAL SECRETS:
# - EMAIL_HOST, EMAIL_USER, EMAIL_PASS: Email configuration
# - ANTHROPIC_API_KEY, AI_CONTENT_API_KEY: AI content generation
# - WEBHOOK_PJ_CLT, WEBHOOK_KODALABS: Vercel deployment webhooks
# - SENTRY_DSN: Error tracking
#
# DEPLOYMENT:
# - Push to main branch triggers automatic deployment
# - Access admin panel: https://cms.kodalabs.dev/admin
# - API endpoint: https://cms.kodalabs.dev/api
# - Health check: https://cms.kodalabs.dev/api/health
