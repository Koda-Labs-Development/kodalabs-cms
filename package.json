{
  "name": "kodalabs-cms",
  "version": "1.0.0",
  "description": "Multi-tenant headless CMS for KodaLabs projects with AI content generation",
  "main": "dist/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "payload build && tsc",
    "serve": "cross-env NODE_ENV=production node dist/server.js",
    "generate:types": "payload generate:types",
    "ai:create-post": "ts-node scripts/ai-content-generator.ts",
    "docker:build": "docker build -t kodalabs-cms:latest -f deployment/docker/Dockerfile .",
    "docker:dev": "docker-compose -f deployment/docker/docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f deployment/docker/docker-compose.prod.yml up -d"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@payloadcms/bundler-webpack": "^1.0.7",
    "@payloadcms/db-postgres": "^0.8.6",
    "@payloadcms/richtext-slate": "^1.5.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "payload": "^2.30.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.2",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
